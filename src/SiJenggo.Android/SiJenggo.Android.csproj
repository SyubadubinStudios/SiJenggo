<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Android head (PLAN M8). Renders straight into a SurfaceView with Renderer.CreateForAndroid and plays
    Story mode with virtual touch controls. ThreeNet 0.9 ships android-arm64 / android-x64 natives in its
    NuGet package. Build: dotnet build src/SiJenggo.Android -c Release  (needs the android workload).
    Not part of SiJenggo.slnx so the desktop build does not require the Android workload.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SiJenggo.Android</RootNamespace>
    <ApplicationId>com.syubadubin.sijenggo</ApplicationId>
    <ApplicationTitle>Si Jenggo</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <!-- Analyzer noise that does not fit an Android activity (Java naming, no ConfigureAwait in UI code). -->
    <NoWarn>$(NoWarn);CA1416;CA2000;CA1848;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiJenggo.Presentation\SiJenggo.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Game assets go into the APK's assets/ and are unpacked to the app's files on first start. -->
    <AndroidAsset Include="..\..\assets\models\*.glb" Link="Assets\models\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\assets\voice\*.wav" Link="Assets\voice\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\assets\lang\*.json" Link="Assets\lang\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
