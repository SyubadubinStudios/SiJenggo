<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SiJenggo.App</RootNamespace>
    <AssemblyName>SiJenggo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sijenggo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="ThreeNet.Avalonia" Version="0.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiJenggo.Presentation\SiJenggo.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Art\*.png" />
    <AvaloniaResource Include="Assets\sijenggo.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Rigged characters, props and weapons exported by tools/blender/sijenggo_pipeline.py -->
    <None Include="..\..\assets\models\*.glb" Link="assets\models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Voice lines (ElevenLabs via Rodin MCP, converted to 22 kHz mono WAV) -->
    <None Include="..\..\assets\voice\*.wav" Link="assets\voice\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Extra languages: English source text -> translation, see docs -->
    <None Include="..\..\assets\lang\*.json" Link="assets\lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
